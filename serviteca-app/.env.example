# ============================================================
# SERVITECA JM - APP MÓVIL
# ============================================================
# Copia este archivo como .env y ajusta la URL del backend.
# Debe apuntar a la raíz de la API (con /api).
#
# Ejemplos:
#   Red local (Expo Go):  http://192.168.1.15:8082/api
#   Producción:           https://api.servitecajm.com/api
#   Túnel temporal:       https://mi-tunel.ngrok-free.app/api
#
# Si no defines esta variable, la app usa la IP que Expo
# detecta automáticamente y el puerto 8082.
# ============================================================

EXPO_PUBLIC_API_URL=http://192.168.1.15:8082/api

# Opcional: cambia el puerto usado por la detección automática.
# EXPO_PUBLIC_API_PORT=8082
