{
  "expo": {
    "name": "Serviteca JM",
    "slug": "serviteca-jm",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.serviteca.jm",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.serviteca.jm"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiPort": 8082,
      "eas": {
        "projectId": "53e08aa1-6412-4a6e-b226-79e488441723"
      }
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 480,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ]
  }
}
