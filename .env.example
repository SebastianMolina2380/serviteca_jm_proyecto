# ============================================================
# SERVITECA JM — VARIABLES PARA DOCKER COMPOSE
# ============================================================
# 1. Copia este archivo como .env (nunca lo subas al repositorio):
#        Copy-Item .env.example .env
# 2. Cambia TODAS las contraseñas por valores largos y aleatorios.
# 3. Levanta el stack:
#        docker compose up -d --build
# 4. Comprueba la salud:
#        docker compose ps
#        curl http://localhost:8082/actuator/health
#
# Genera secretos con, por ejemplo:
#        openssl rand -base64 24
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_DB=DB_PRODISJM
POSTGRES_USER=serviteca
POSTGRES_PASSWORD=cambia_esta_contrasena_de_base_de_datos

# ── Aplicación ──────────────────────────────────────────────
SERVITECA_PROFILE=prod

# En local sin TLS la cookie no puede ser Secure. Si publicas detrás
# de HTTPS, cambia a true.
SERVITECA_COOKIE_SECURE=false

# Documentación interactiva desactivada en producción. Pon true solo
# para depurar un despliegue concreto.
SERVITECA_API_DOCS=false

# URL pública usada en los enlaces de recuperación de contraseña.
SERVITECA_APP_URL=http://localhost:8082

# ── Administrador inicial (solo se usa si la base está vacía) ─
# La contraseña debe tener al menos 16 caracteres. Tras el primer
# arranque, retira estas variables del entorno.
INITIAL_ADMIN_NAME=Administrador Serviteca
INITIAL_ADMIN_DOCUMENT=1000000001
INITIAL_ADMIN_DOCUMENT_TYPE=CC
INITIAL_ADMIN_EMAIL=admin@servitecajm.com
INITIAL_ADMIN_PASSWORD=cambia_esta_contrasena_de_al_menos_16

# ── Correo transaccional (opcional) ─────────────────────────
# Sin SERVITECA_SMTP_HOST los correos se registran en el log.
SERVITECA_SMTP_HOST=
SERVITECA_SMTP_PORT=587
SERVITECA_SMTP_USER=
SERVITECA_SMTP_PASSWORD=
SERVITECA_MAIL_FROM=no-reply@servitecajm.com
SERVITECA_CONTACTO_EMAIL=contacto@servitecajm.com
